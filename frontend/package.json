{
	"name": "sertantai-legal-frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5175",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.1.17",
		"@tailwindcss/typography": "^0.5.19",
		"@testing-library/svelte": "^5.2.9",
		"@types/node": "^25.6.0",
		"@typescript-eslint/eslint-plugin": "^8.46.4",
		"@typescript-eslint/parser": "^8.46.4",
		"@vitest/coverage-v8": "^4.1.4",
		"@vitest/ui": "^4.0.9",
		"autoprefixer": "^10.4.22",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"jsdom": "^27.2.0",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.1.17",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.0",
		"vitest": "^4.0.9"
	},
	"type": "module",
	"dependencies": {
		"@electric-sql/client": "^1.5.26",
		"@electric-sql/pglite": "^0.5.6",
		"@electric-sql/pglite-sync": "^0.6.7",
		"@shotleybuilder/gridlite-adapter-pglite": "^0.7.3",
		"@shotleybuilder/svelte-gridlite-kit": "^0.10.0",
		"@shotleybuilder/svelte-gridlite-views": "^0.2.1",
		"@tanstack/svelte-query": "^6.1.38",
		"date-fns": "^4.1.0",
		"jsondiffpatch": "^0.7.3"
	}
}
