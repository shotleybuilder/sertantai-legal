#!/bin/bash
# Start/stop legal's always-on dev container: the shared Electric sync service
# (legal-electric, port 3002).
#
# Auth and the hub are no longer legal's: they live in sertantai-stack's dev
# compose (sertantai-stack/docker/docker-compose.dev.yml, project sertantai-dev;
# Jason 2026-11-21). Manage them from there:
#   docker compose -p sertantai-dev -f docker/docker-compose.dev.yml --env-file docker/.env.dev ps
#
# legal-electric auto-restarts on boot (restart: unless-stopped).
#
# Usage:
#   sert-up              # Start (or verify running)
#   sert-up --pull       # Pull the latest Electric image first
#   sert-up --status     # Show container status only
#   sert-up --stop       # Stop legal-electric
#
# Symlink:
#   sudo ln -sf $(pwd)/scripts/development/sert-up /usr/local/bin/sert-up

set -e

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"
COMPOSE_FILE="$PROJECT_ROOT/docker-compose.services.yml"
SERVICE=legal-electric

PULL_IMAGES=false
STATUS_ONLY=false
STOP_ALL=false

for arg in "$@"; do
    case $arg in
        --pull) PULL_IMAGES=true ;;
        --status) STATUS_ONLY=true ;;
        --stop) STOP_ALL=true ;;
    esac
done

stack_note() {
    echo ""
    echo "Auth and the hub are managed in sertantai-stack:"
    echo "  cd ~/Desktop/sertantai-stack && docker compose -p sertantai-dev -f docker/docker-compose.dev.yml --env-file docker/.env.dev ps"
}

if [ ! -f "$COMPOSE_FILE" ]; then
    echo "Error: $COMPOSE_FILE not found"
    exit 1
fi

if [ "$STATUS_ONLY" = true ]; then
    echo "legal-electric status:"
    echo ""
    docker compose -f "$COMPOSE_FILE" ps "$SERVICE"
    stack_note
    exit 0
fi

if [ "$STOP_ALL" = true ]; then
    echo "Stopping $SERVICE..."
    docker compose -f "$COMPOSE_FILE" stop "$SERVICE"
    echo ""
    echo "Stopped. It will NOT auto-restart until you run: sert-up"
    exit 0
fi

# ── Pull the latest image if requested ──────────────────────────────────
if [ "$PULL_IMAGES" = true ]; then
    echo "Pulling the latest Electric image..."
    docker compose -f "$COMPOSE_FILE" pull "$SERVICE"
fi

# ── Start legal-electric alone (never the other services) ───────────────
echo "Starting $SERVICE..."
cd "$PROJECT_ROOT"
docker compose -f "$COMPOSE_FILE" up -d --no-deps "$SERVICE"

# ── Wait for health ─────────────────────────────────────────────────────
echo -n "Waiting for electric (port 3002)..."
for i in $(seq 1 30); do
    if curl -s -o /dev/null -w "%{http_code}" "http://localhost:3002/v1/health" 2>/dev/null | grep -qE "200|204"; then
        echo " ready"; break
    fi
    [ "$i" -eq 30 ] && echo " timeout (check: docker compose -f docker-compose.services.yml logs $SERVICE)"
    sleep 1; echo -n "."
done

echo ""
echo "  Electric:      http://localhost:3002"
echo ""
echo "To develop legal: sert-dev"
echo "Management: sert-up --status | --stop | --pull"
stack_note
