#!/bin/bash
# sertantai-legal Development Server Stopper
# Stops backend (Phoenix) and frontend (SvelteKit) servers
#
# Usage:
#   sert-legal-stop                # Stop legal servers only (leave Docker + services running)
#   sert-legal-stop --docker       # Stop legal servers + legal Docker containers
#   sert-legal-stop --services     # Also stop auth + hub service containers
#   sert-legal-stop --auth         # Also stop sertantai-auth (container or source)
#   sert-legal-stop --hub          # Also stop sertantai-hub (container or source)
#
# Symlink Setup (to run from anywhere):
#   sudo ln -s /home/jason/Desktop/sertantai-legal/scripts/development/sert-legal-stop /usr/local/bin/sert-legal-stop

set -e

# Parse arguments
MANAGE_DOCKER=false
MANAGE_AUTH=false
MANAGE_HUB=false
MANAGE_SERVICES=false
for arg in "$@"; do
    case $arg in
        --docker)
            MANAGE_DOCKER=true
            ;;
        --auth)
            MANAGE_AUTH=true
            ;;
        --hub)
            MANAGE_HUB=true
            ;;
        --services)
            MANAGE_SERVICES=true
            MANAGE_AUTH=true
            MANAGE_HUB=true
            ;;
    esac
done

# Resolve symlink to get the actual script path
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"

# sertantai-auth project location
AUTH_PROJECT_ROOT="$HOME/Desktop/sertantai-auth"
AUTH_PORT=4000

# sertantai-hub project location
HUB_PROJECT_ROOT="$HOME/Desktop/sertantai-hub"
HUB_PORT=4006
HUB_FRONTEND_PORT=5173

echo "Stopping sertantai-legal development servers..."

# Kill Phoenix backend processes (port 4003)
if lsof -ti:4003 >/dev/null 2>&1; then
    echo "Killing Phoenix backend processes (port 4003)..."
    lsof -ti:4003 | xargs kill -9 2>/dev/null || true
    sleep 0.5
    echo "   Phoenix processes killed"
else
    echo "   No Phoenix backend processes found (port 4003 not in use)"
fi

# Kill SvelteKit frontend processes (port 5175)
if lsof -ti:5175 >/dev/null 2>&1; then
    echo "Killing SvelteKit frontend processes (port 5175)..."
    lsof -ti:5175 | xargs kill -9 2>/dev/null || true
    sleep 0.5
    echo "   SvelteKit processes killed"
else
    echo "   No SvelteKit frontend processes found (port 5175 not in use)"
fi

# Clean up any remaining Elixir BEAM processes for this project
if pgrep -f "beam.smp.*sertantai_legal" > /dev/null; then
    echo "Cleaning up remaining BEAM VM processes..."
    pkill -9 -f "beam.smp.*sertantai_legal" || true
    echo "   BEAM processes cleaned up"
fi

# Stop Docker services if requested
if [ "$MANAGE_DOCKER" = true ]; then
    echo ""
    echo "Stopping Docker containers..."
    cd "$PROJECT_ROOT"
    docker compose -f docker-compose.dev.yml stop
    echo "   Docker containers stopped"
fi

# ============================================================================
# Stop sertantai-auth if requested
# ============================================================================
if [ "$MANAGE_AUTH" = true ]; then
    echo ""
    echo "Stopping sertantai-auth..."

    # Stop auth container (from services compose)
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "sertantai-auth$"; then
        echo "   Stopping sertantai-auth container..."
        docker stop sertantai-auth 2>/dev/null || true
        echo "   sertantai-auth container stopped"
    fi

    # Kill auth source processes (legacy mode, port 4000)
    if lsof -ti:$AUTH_PORT >/dev/null 2>&1; then
        echo "   Killing sertantai-auth source processes (port $AUTH_PORT)..."
        lsof -ti:$AUTH_PORT | xargs kill -9 2>/dev/null || true
        sleep 0.5
        echo "   sertantai-auth processes killed"
    fi

    # Clean up auth BEAM processes
    if pgrep -f "beam.smp.*sertantai_auth\|beam.smp.*sertantai-auth" > /dev/null; then
        pkill -9 -f "beam.smp.*sertantai_auth\|beam.smp.*sertantai-auth" || true
        echo "   sertantai-auth BEAM processes cleaned up"
    fi

    # Stop auth postgres container if --docker
    if [ "$MANAGE_DOCKER" = true ]; then
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "sertantai-auth-postgres"; then
            echo "   Stopping sertantai-auth-postgres container..."
            docker stop sertantai-auth-postgres 2>/dev/null || true
        fi
        # Also handle old-style container names
        if [ -d "$AUTH_PROJECT_ROOT" ]; then
            cd "$AUTH_PROJECT_ROOT"
            docker compose -f docker-compose.dev.yml stop 2>/dev/null || true
        fi
    fi
fi

# ============================================================================
# Stop sertantai-hub if requested
# ============================================================================
if [ "$MANAGE_HUB" = true ]; then
    echo ""
    echo "Stopping sertantai-hub..."

    # Stop hub containers (from services compose)
    for name in sertantai-hub-backend sertantai-hub-frontend sertantai-hub-electric; do
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${name}$"; then
            echo "   Stopping $name container..."
            docker stop "$name" 2>/dev/null || true
        fi
    done

    # Kill hub source processes (legacy mode)
    if lsof -ti:$HUB_PORT >/dev/null 2>&1; then
        echo "   Killing sertantai-hub source processes (port $HUB_PORT)..."
        lsof -ti:$HUB_PORT | xargs kill -9 2>/dev/null || true
        sleep 0.5
    fi

    if lsof -ti:$HUB_FRONTEND_PORT >/dev/null 2>&1; then
        echo "   Killing sertantai-hub frontend (port $HUB_FRONTEND_PORT)..."
        lsof -ti:$HUB_FRONTEND_PORT | xargs kill -9 2>/dev/null || true
        sleep 0.5
    fi

    # Clean up hub BEAM processes
    if pgrep -f "beam.smp.*sertantai_hub\|beam.smp.*starter_app" > /dev/null; then
        pkill -9 -f "beam.smp.*sertantai_hub\|beam.smp.*starter_app" || true
        echo "   sertantai-hub BEAM processes cleaned up"
    fi

    # Stop hub postgres if --docker
    if [ "$MANAGE_DOCKER" = true ]; then
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "sertantai-hub-postgres"; then
            echo "   Stopping sertantai-hub-postgres container..."
            docker stop sertantai-hub-postgres 2>/dev/null || true
        fi
        if [ -d "$HUB_PROJECT_ROOT" ]; then
            cd "$HUB_PROJECT_ROOT"
            docker compose -f docker-compose.dev.yml stop 2>/dev/null || true
        fi
    fi
fi

echo ""
echo "All development servers stopped!"
echo ""
echo "To start again: sert-legal-start"
if [ "$MANAGE_DOCKER" != true ]; then
    echo "Tip: Docker containers are still running. Use '--docker' to stop them too."
fi
if [ "$MANAGE_AUTH" = true ] || [ "$MANAGE_HUB" = true ]; then
    echo "Tip: Restart auth + hub containers with: sert-services-up"
fi
echo ""
