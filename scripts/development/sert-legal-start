#!/bin/bash
# sertantai-legal Development Server Starter
# Starts backend (Phoenix) and frontend (SvelteKit) in terminal tabs
#
# Auth + Hub run as always-on containers (see docker-compose.services.yml).
# This script auto-detects them and only opens tabs for legal.
#
# Usage:
#   sert-legal-start                # Start legal (auto-starts Docker if needed)
#   sert-legal-start --docker       # Force restart Docker containers + servers
#   sert-legal-start --zenoh        # Enable Zenoh P2P mesh
#   sert-legal-start --auth         # Also start auth from source (legacy mode)
#   sert-legal-start --hub          # Also start hub from source (legacy mode)
#
# Symlink Setup (to run from anywhere):
#   sudo ln -s /home/jason/Desktop/sertantai-legal/scripts/development/sert-legal-start /usr/local/bin/sert-legal-start

set -e

# Parse arguments
MANAGE_DOCKER=false
MANAGE_AUTH=false
MANAGE_HUB=false
ENABLE_ZENOH=false
for arg in "$@"; do
    case $arg in
        --docker)
            MANAGE_DOCKER=true
            ;;
        --auth)
            MANAGE_AUTH=true
            ;;
        --hub)
            MANAGE_HUB=true
            ;;
        --zenoh)
            ENABLE_ZENOH=true
            ;;
    esac
done

# ============================================================================
# Terminal emulator detection (Ubuntu=gnome-terminal, Bluefin/Fedora=ptyxis)
# ============================================================================
if command -v gnome-terminal &>/dev/null; then
    TERMINAL_CMD="gnome-terminal"
elif command -v ptyxis &>/dev/null; then
    TERMINAL_CMD="ptyxis"
else
    echo "Error: No supported terminal emulator found (gnome-terminal or ptyxis)"
    exit 1
fi

# Open a new tab with a title, working directory, and command
# Usage: open_tab "title" "working_dir" "command"
open_tab() {
    local title="$1" dir="$2" cmd="$3"
    if [ "$TERMINAL_CMD" = "gnome-terminal" ]; then
        gnome-terminal --tab --title="$title" --working-directory="$dir" -- bash -c "$cmd" &
    else
        # ptyxis -x has quoting issues with complex commands, so use a temp script
        local tmpscript
        tmpscript=$(mktemp /tmp/ptyxis-tab-XXXXXX.sh)
        cat > "$tmpscript" << TABEOF
#!/bin/bash -l
cd "$dir"
$cmd
rm -f "$tmpscript"
TABEOF
        chmod +x "$tmpscript"
        ptyxis --tab -T "$title" -x "$tmpscript" &
    fi
}

# Resolve symlink to get the actual script path
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"

# sertantai-auth project location (for legacy --auth mode)
AUTH_PROJECT_ROOT="$HOME/Desktop/sertantai-auth"
AUTH_PORT=4000
AUTH_DB_PORT=5438

# sertantai-hub project location (for legacy --hub mode)
HUB_PROJECT_ROOT="$HOME/Desktop/sertantai-hub"
HUB_PORT=4006
HUB_FRONTEND_PORT=5173
HUB_DB_PORT=5435

echo "Starting sertantai-legal development servers..."
echo "Project root: $PROJECT_ROOT"
echo ""

# Verify PROJECT_ROOT exists
if [ ! -d "$PROJECT_ROOT" ]; then
    echo "Error: Project root directory not found: $PROJECT_ROOT"
    exit 1
fi

if [ ! -f "$PROJECT_ROOT/backend/mix.exs" ]; then
    echo "Error: mix.exs not found in $PROJECT_ROOT/backend"
    exit 1
fi

# Check if servers are already running
if pgrep -f "mix phx.server.*sertantai_legal" > /dev/null; then
    echo "Warning: Phoenix backend is already running!"
    echo "   Stop it first with: sert-legal-stop"
    exit 1
fi

if lsof -ti:5175 >/dev/null 2>&1; then
    echo "Warning: SvelteKit frontend is already running on port 5175!"
    echo "   Stop it first with: sert-legal-stop"
    exit 1
fi

# ============================================================================
# Auth + Hub service detection
# ============================================================================
# Prefer containerized services. Fall back to --auth/--hub source mode.

check_auth_running() {
    curl -s -o /dev/null -w "%{http_code}" "http://localhost:$AUTH_PORT/health" 2>/dev/null | grep -q "200"
}

check_hub_running() {
    curl -s -o /dev/null -w "%{http_code}" "http://localhost:$HUB_PORT/health" 2>/dev/null | grep -q "200"
}

check_auth_container() {
    docker ps --format '{{.Names}}' 2>/dev/null | grep -q "sertantai-auth$"
}

check_hub_container() {
    docker ps --format '{{.Names}}' 2>/dev/null | grep -q "sertantai-hub-backend"
}

# ── Auth status ──────────────────────────────────────────────────────────
if [ "$MANAGE_AUTH" = true ]; then
    # Legacy mode: start auth from source
    echo "Starting sertantai-auth from source (legacy --auth mode)..."

    if [ ! -d "$AUTH_PROJECT_ROOT" ]; then
        echo "Error: sertantai-auth project not found at $AUTH_PROJECT_ROOT"
        exit 1
    fi

    if check_auth_running; then
        echo "   sertantai-auth already running on port $AUTH_PORT"
    else
        # Check/start auth postgres container
        if ! docker ps --format '{{.Names}}' | grep -q "sertantai-auth.*postgres"; then
            echo "   Starting sertantai-auth PostgreSQL (port $AUTH_DB_PORT)..."
            cd "$AUTH_PROJECT_ROOT"
            docker compose -f docker-compose.dev.yml up -d postgres
            echo -n "   Waiting for auth postgres..."
            for i in $(seq 1 15); do
                if docker compose -f docker-compose.dev.yml exec -T postgres pg_isready -U postgres >/dev/null 2>&1; then
                    echo " ready"
                    break
                fi
                [ "$i" -eq 15 ] && echo " timeout"
                sleep 1; echo -n "."
            done
            cd "$PROJECT_ROOT"
        fi

        echo "   Starting sertantai-auth Phoenix server (port $AUTH_PORT)..."
        open_tab "sertantai-auth-backend" "$AUTH_PROJECT_ROOT" "echo 'Starting sertantai-auth on port $AUTH_PORT...'; unset DATABASE_URL; mix phx.server; echo ''; echo 'Service stopped. Press Enter to close tab...'; read"

        echo -n "   Waiting for sertantai-auth to be ready..."
        for i in $(seq 1 30); do
            if check_auth_running; then echo " ready"; break; fi
            [ "$i" -eq 30 ] && echo " timeout"
            sleep 1; echo -n "."
        done
    fi
    echo ""
elif check_auth_running; then
    if check_auth_container; then
        echo "Auth:  running (container) on port $AUTH_PORT"
    else
        echo "Auth:  running (source) on port $AUTH_PORT"
    fi
else
    echo "Auth:  not running (port $AUTH_PORT)"
    echo "   Run 'sert-services-up' to start auth + hub containers"
fi

# ── Hub status ───────────────────────────────────────────────────────────
if [ "$MANAGE_HUB" = true ]; then
    # Legacy mode: start hub from source
    echo "Starting sertantai-hub from source (legacy --hub mode)..."

    if [ ! -d "$HUB_PROJECT_ROOT" ]; then
        echo "Error: sertantai-hub project not found at $HUB_PROJECT_ROOT"
        exit 1
    fi

    if check_hub_running; then
        echo "   sertantai-hub backend already running on port $HUB_PORT"
    else
        # Check/start hub postgres container
        if ! docker ps --format '{{.Names}}' | grep -q "sertantai-hub.*postgres"; then
            echo "   Starting sertantai-hub PostgreSQL (port $HUB_DB_PORT)..."
            cd "$HUB_PROJECT_ROOT"
            docker compose -f docker-compose.dev.yml up -d postgres
            echo -n "   Waiting for hub postgres..."
            for i in $(seq 1 15); do
                if docker compose -f docker-compose.dev.yml exec -T postgres pg_isready -U postgres >/dev/null 2>&1; then
                    echo " ready"
                    break
                fi
                [ "$i" -eq 15 ] && echo " timeout"
                sleep 1; echo -n "."
            done
            cd "$PROJECT_ROOT"
        fi

        echo "   Starting sertantai-hub Phoenix server (port $HUB_PORT)..."
        open_tab "sertantai-hub-backend" "$HUB_PROJECT_ROOT/backend" "echo 'Starting sertantai-hub on port $HUB_PORT...'; unset DATABASE_URL; mix phx.server; echo ''; echo 'Service stopped. Press Enter to close tab...'; read"

        echo -n "   Waiting for sertantai-hub to be ready..."
        for i in $(seq 1 30); do
            if check_hub_running; then echo " ready"; break; fi
            [ "$i" -eq 30 ] && echo " timeout"
            sleep 1; echo -n "."
        done
    fi

    # Start hub frontend
    if lsof -ti:$HUB_FRONTEND_PORT >/dev/null 2>&1; then
        echo "   sertantai-hub frontend already running on port $HUB_FRONTEND_PORT"
    else
        echo "   Starting sertantai-hub frontend (port $HUB_FRONTEND_PORT)..."
        open_tab "sertantai-hub-frontend" "$HUB_PROJECT_ROOT/frontend" "echo 'Starting sertantai-hub frontend on port $HUB_FRONTEND_PORT...'; npm run dev; echo ''; echo 'Service stopped. Press Enter to close tab...'; read"
    fi
    echo ""
elif check_hub_running; then
    if check_hub_container; then
        echo "Hub:   running (container) — backend :$HUB_PORT, frontend :$HUB_FRONTEND_PORT"
    else
        echo "Hub:   running (source) on port $HUB_PORT"
    fi
else
    echo "Hub:   not running (port $HUB_PORT)"
    echo "   Run 'sert-services-up' to start auth + hub containers"
fi

echo ""

# ============================================================================
# Docker container management (sertantai-legal)
# ============================================================================
if [ "$MANAGE_DOCKER" = true ]; then
    echo "Managing Docker containers..."
    cd "$PROJECT_ROOT"

    NEED_START=false
    if ! docker ps | grep -q "sertantai-legal-postgres"; then
        NEED_START=true
    fi
    if ! docker ps | grep -q "sertantai-legal-electric"; then
        NEED_START=true
    fi

    if [ "$NEED_START" = true ]; then
        echo "   Starting Docker services (postgres + electric)..."
        docker compose -f docker-compose.dev.yml up -d postgres
        echo "   Waiting for postgres to be healthy..."
        sleep 5
        docker compose -f docker-compose.dev.yml up -d --no-deps electric

        echo -n "   Waiting for ElectricSQL..."
        for i in $(seq 1 30); do
            if curl -s -o /dev/null -w "" http://localhost:3002/v1/health 2>/dev/null; then
                echo " ready"; break
            fi
            [ "$i" -eq 30 ] && echo " timeout"
            sleep 1; echo -n "."
        done
    else
        echo "   Docker services already running"
    fi
    echo ""
else
    # Auto-start Docker services if not running (postgres + electric are always required)
    cd "$PROJECT_ROOT"
    NEED_START=false
    MISSING=""
    if ! docker ps | grep -q "sertantai-legal-postgres"; then
        NEED_START=true
        MISSING="postgres"
    fi
    if ! docker ps | grep -q "sertantai-legal-electric"; then
        NEED_START=true
        if [ -n "$MISSING" ]; then MISSING="$MISSING, electric"; else MISSING="electric"; fi
    fi
    if [ "$NEED_START" = true ]; then
        echo "Docker containers not running ($MISSING), starting..."
        docker compose -f docker-compose.dev.yml up -d postgres
        echo -n "   Waiting for postgres..."
        for i in $(seq 1 15); do
            if docker compose -f docker-compose.dev.yml exec -T postgres pg_isready -U postgres >/dev/null 2>&1; then
                echo " ready"; break
            fi
            [ "$i" -eq 15 ] && echo " timeout"
            sleep 1; echo -n "."
        done
        docker compose -f docker-compose.dev.yml up -d --no-deps electric
        echo -n "   Waiting for ElectricSQL..."
        for i in $(seq 1 30); do
            if curl -s -o /dev/null -w "" http://localhost:3002/v1/health 2>/dev/null; then
                echo " ready"; break
            fi
            [ "$i" -eq 30 ] && echo " timeout"
            sleep 1; echo -n "."
        done
    else
        echo "Docker services already running (postgres + electric)"
    fi
    echo ""
fi

# ============================================================================
# Start sertantai-legal servers
# ============================================================================
echo "Opening terminal tabs..."

# Build Zenoh env/echo strings
ZENOH_ENV=""
ZENOH_ECHO=""
if [ "$ENABLE_ZENOH" = true ]; then
    ZENOH_ENV="ZENOH_ENABLED=true ZENOH_TENANT=dev "
    ZENOH_ECHO='echo "Zenoh P2P: enabled"; '
fi

# Open Phoenix backend tab
BACKEND_CMD="${ZENOH_ECHO}echo 'Starting Phoenix backend on port 4003...'; echo 'Working directory: '\$(pwd); echo ''; unset DATABASE_URL; ${ZENOH_ENV}mix phx.server; echo ''; echo 'Service stopped. Press Enter to close tab...'; read"
open_tab "sertantai-legal-backend" "$PROJECT_ROOT/backend" "$BACKEND_CMD"
sleep 0.3

# Open SvelteKit frontend tab
FRONTEND_CMD="echo 'Starting SvelteKit frontend on port 5175...'; echo 'Working directory: '\$(pwd); echo ''; npm run dev; echo ''; echo 'Service stopped. Press Enter to close tab...'; read"
open_tab "sertantai-legal-frontend" "$PROJECT_ROOT/frontend" "$FRONTEND_CMD"

echo ""
echo "Development servers starting in terminal tabs!"
echo ""
echo "URLs:"
echo "   Backend:  http://localhost:4003  (phoenix)"
echo "   Frontend: http://localhost:5175  (svelte)"
echo "   Electric: http://localhost:3002  (sync)"
if check_auth_running 2>/dev/null; then
    echo "   Auth:     http://localhost:$AUTH_PORT  (sertantai-auth)"
fi
if check_hub_running 2>/dev/null; then
    echo "   Hub:      http://localhost:$HUB_PORT  (sertantai-hub)"
    echo "   Hub UI:   http://localhost:$HUB_FRONTEND_PORT  (login)"
fi
if [ "$ENABLE_ZENOH" = true ]; then
    echo "   Zenoh:    enabled (tenant=dev, multicast scouting)"
fi
echo ""
echo "To stop: sert-legal-stop"
echo ""
